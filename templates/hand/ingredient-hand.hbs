<div class="sls-hand-v3">
    
    <!-- ХЕДЕР -->
    <header class="v3-header">
        <div class="v3-header-left">
            <h1 class="v3-title"><i class="fas fa-hand-holding-magic"></i> Рука Лута</h1>
            {{#if isGM}}
            <div class="gm-user-switch">
                <i class="fas fa-user-crown"></i>
                <select id="user-select">
                    {{#each users}}
                    <option value="{{this.id}}" {{#if this.isSelected}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
            {{/if}}
        </div>
        <div class="v3-header-right">
            <div id="collection-status" class="v3-status {{#if isCollecting}}active{{/if}}">
                {{#if isCollecting}}
                    <i class="fas fa-sync fa-spin"></i> Сбор активен
                {{else}}
                    <i class="fas fa-pause-circle"></i> Ожидание
                {{/if}}
            </div>
        </div>
    </header>

    <main class="v3-main-content">
        
        <!-- НАСТРОЙКИ -->
        <section class="v3-quick-settings {{#unless isSelf}}readonly{{/unless}}">
            <div class="v3-field">
                <label>Биом (Локация)</label>
                <select id="biome-select" name="biome" {{#unless isSelf}}disabled{{/unless}}>
                    {{#each biomes}}
                        <option value="{{this.key}}" {{#if (eq this.key ../currentBiome)}}selected{{/if}}>{{this.label}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="v3-field short">
                <label>План сбора</label>
                <input type="number" id="target-amount" name="targetAmount" value="{{targetAmount}}" {{#unless isSelf}}disabled{{/unless}}>
            </div>
            <div class="v3-field short">
                <label>Множитель</label>
                <select id="collection-speed" name="collectionSpeed" {{#unless isSelf}}disabled{{/unless}}>
                    <option value="0.1" {{#if (eq collectionSpeed "0.1")}}selected{{/if}}>x0.1</option>
                    <option value="0.5" {{#if (eq collectionSpeed "0.5")}}selected{{/if}}>x0.5</option>
                    <option value="1" {{#if (eq collectionSpeed "1")}}selected{{/if}}>x1.0</option>
                    <option value="2" {{#if (eq collectionSpeed "2")}}selected{{/if}}>x2.0</option>
                    <option value="5" {{#if (eq collectionSpeed "5")}}selected{{/if}}>x5.0</option>
                </select>
            </div>
        </section>

        <div class="v3-workspace">
            
            <!-- ЛЕВО -->
            <aside class="v3-aside-controls">
                
                <div class="v3-card v3-progress-card">
                    <div class="v3-biome-orb-wrap">
                        <div class="v3-orb-glow glow-{{currentBiome}}"></div>
                        <img src="modules/scene-loot-spawner/assets/biomes/{{currentBiome}}.png" class="v3-biome-img" onerror="this.src='modules/scene-loot-spawner/assets/biomes/forest.png'">
                    </div>
                    
                    <div class="v3-progress-info">
                        <div class="v3-progress-bar"><div class="fill" style="width: {{progress.percentage}}%"></div></div>
                        <div class="v3-progress-labels">
                            <span class="v3-perc">{{progress.percentage}}%</span>
                            <span class="v3-counts">{{progress.collectedCount}}/{{targetAmount}}</span>
                        </div>
                    </div>

                    <div class="v3-action-buttons">
                        {{#if isSelf}}
                            {{#if isCollecting}}
                                <button id="stop-collection" class="v3-action-btn stop">
                                    <i class="fas fa-hand-paper"></i> СТОП
                                </button>
                            {{else}}
                                <button id="start-collection" class="v3-action-btn start">
                                    <i class="fas fa-wand-magic-sparkles"></i> ИСКАТЬ
                                </button>
                            {{/if}}
                            <button id="reset-progress" class="v3-action-btn reset">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        {{/if}}
                    </div>
                </div>

                <div class="v3-card v3-filters-card {{#unless isSelf}}readonly{{/unless}}">
                    <div class="v3-filter-sec">
                        <span class="v3-sec-label">Редкость</span>
                        <div class="v3-checkbox-grid">
                            <label><input type="checkbox" name="rarityType" value="common" {{#if checks.commonRarity}}checked{{/if}}> Обычные</label>
                            <label><input type="checkbox" name="rarityType" value="uncommon" {{#if checks.uncommonRarity}}checked{{/if}}> Необычные</label>
                            <label><input type="checkbox" name="rarityType" value="rare" {{#if checks.rareRarity}}checked{{/if}}> Редкие</label>
                            <label><input type="checkbox" name="rarityType" value="veryRare" {{#if checks.veryRareRarity}}checked{{/if}}> Очень редкие</label>
                            <label><input type="checkbox" name="rarityType" value="legendary" {{#if checks.legendaryRarity}}checked{{/if}}> Легендарные</label>
                        </div>
                    </div>
                    <div class="v3-filter-sec">
                        <span class="v3-sec-label">Категории</span>
                        <div class="v3-checkbox-grid cat">
                            <label><input type="checkbox" name="ingredientType" value="herbs" {{#if checks.herbs}}checked{{/if}}> Травы/Еда</label>
                            <label><input type="checkbox" name="ingredientType" value="ore" {{#if checks.ore}}checked{{/if}}> Руда</label>
                            <label><input type="checkbox" name="ingredientType" value="crystals" {{#if checks.crystals}}checked{{/if}}> Кристаллы</label>
                            <label><input type="checkbox" name="ingredientType" value="reagents" {{#if checks.reagents}}checked{{/if}}> Реагенты</label>
                            <label><input type="checkbox" name="ingredientType" value="alchemy" {{#if checks.alchemy}}checked{{/if}}> Алхимия</label>
                            <label><input type="checkbox" name="ingredientType" value="other" {{#if checks.other}}checked{{/if}}> Прочее</label>
                        </div>
                    </div>
                </div>

            </aside>

            <!-- ПРАВО -->
            <div class="v3-data-columns">
                
                <div class="v3-card v3-list-card v3-available">
                    <h3 class="v3-box-header"><i class="fas fa-search"></i> Доступно в зоне</h3>
                    <div class="v3-grid-scroll-area">
                        <div class="v3-items-grid">
                            {{#each availableIngredients}}
                                <div class="v3-grid-item rarity-{{this.rarity}} rarity-glow-{{this.rarity}}" title="{{this.name}}">
                                    <img src="{{this.img}}">
                                    <span class="v3-item-badge chance">{{this.chance}}%</span>
                                </div>
                            {{/each}}
                        </div>
                    </div>
                </div>

                <div class="v3-card v3-list-card v3-inventory">
                    <h3 class="v3-box-header"><i class="fas fa-briefcase"></i> Ваша добыча</h3>
                    <div class="v3-grid-scroll-area">
                        <div class="v3-items-grid">
                            {{#each collected}}
                                <div class="v3-grid-item rarity-glow-{{this.rarity}}" title="{{this.name}}">
                                    <img src="{{this.img}}">
                                    <span class="v3-item-badge qty">x{{this.quantity}}</span>
                                </div>
                            {{/each}}
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </main>
</div>